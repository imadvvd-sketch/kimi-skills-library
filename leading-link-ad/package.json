{
  "name": "leading-link-ad",
  "version": "1.0.0",
  "private": true,
  "description": "60-second motion graphics ad for The Leading Link, built with Remotion",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "typecheck": "tsc --noEmit",
    "voiceover": "python3 scripts/generate_voiceover.py",
    "music": "python3 scripts/generate_music.py",
    "stills": "node scripts/render-stills.mjs",
    "render": "remotion render LeadingLinkAd out/leading-link-ad.mp4 --codec=h264 --crf=18",
    "render:vertical": "remotion render LeadingLinkAdVertical out/leading-link-ad-vertical.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.532",
    "@remotion/google-fonts": "^4.0.532",
    "@remotion/transitions": "^4.0.532",
    "@remotion/zod-types": "^4.0.532",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.532",
    "@remotion/renderer": "^4.0.532",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
